<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App 内部存储 files 目录下的所有文件，相机拍照临时存放在 images 子目录 -->
    <files-path
        name="images"
        path="images/" />
    <!-- 缓存目录，用于临时存放相机照片 -->
    <cache-path
        name="cache"
        path="." />
    <!-- 外部缓存目录 -->
    <external-cache-path
        name="external_cache"
        path="." />
</paths>
