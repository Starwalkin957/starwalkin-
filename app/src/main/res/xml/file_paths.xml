<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App 内部存储 files 目录下的所有文件（images 图片、backup 备份） -->
    <files-path
        name="files"
        path="." />
    <!-- 缓存目录 -->
    <cache-path
        name="cache"
        path="." />
    <!-- 外部缓存目录 -->
    <external-cache-path
        name="external_cache"
        path="." />
</paths>
